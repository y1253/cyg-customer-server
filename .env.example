# Copy to .env. The SAME `cygfinance` database the internal app uses.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/cygfinance
PORT=3001

# Mail: the contact form (POST /api/contact) and signup verification codes. Same setup as
# the internal app's admin 2FA mail. SMTP_USER is the mailbox that logs in; SMTP_PASS is a Google APP password for
# it, not the account password. Port 587, never 465: Hetzner Cloud blocks outbound 465.
# CONTACT_TO is where submissions are delivered.
SMTP_USER=chaim@cygfinance.com
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM_NAME=CYG Finance website
# SMTP_FROM: the address mail is sent FROM (contact form + signup codes). Must be a
# verified "Send mail as" alias of SMTP_USER in Gmail, or Gmail rewrites it to SMTP_USER.
SMTP_FROM=office@cygfinance.com
CONTACT_TO=office@cygfinance.com
# Dev only (ignored when NODE_ENV=production): log signup codes instead of emailing them.
# CUSTOMER_SIGNUP_LOG_CODE=1
# Customer accounts. NOT the internal app's JWT_SECRET -- a separate random value
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
CUSTOMER_JWT_SECRET=
# Sign in with Google: the SAME OAuth client id as the internal app's GOOGLE_CLIENT_ID.
# Its Google Cloud Console entry must list this site under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Bookkeeping: OpenAI reads the statements (same key as the internal app) ...
OPENAI_API_KEY=
OPENAI_BOOKKEEPING_MODEL=           # optional, default gpt-4o
# step12: a customer's complaint about the AI goes to a stronger model that fixes the AI's
# instructions (customer/CLAUDE.md "Strong AI"). Off unless STRONG_AI=1.
STRONG_AI=
OPENAI_STRONG_MODEL=                # optional, default gpt-6-astra
OPENAI_STRONG_EFFORT=               # optional, low|medium|high|xhigh|max, default high
STRONG_AI_DAILY_LIMIT=              # optional, default 20 hand-offs a day
STRONG_AI_TIMEOUT_MS=               # optional, default 150000
# ... and the original PDFs are kept in the same Cloudflare R2 bucket as the internal app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
UPLOADS_DIR=                        # optional transit dir for uploads, default server/uploads
# Pay per Generate (Stripe). A restricted key (rk_...) works: it needs Customers,
# PaymentIntents, PaymentMethods = write and Charges = read. No key = Generate stays
# free only while the admin price is $0 (a paid checkout answers 503).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional safety net: Stripe → Webhooks → https://cygfinance.com/api/billing/webhook,
# event payment_intent.succeeded. Unset = the webhook route answers 404.
STRIPE_WEBHOOK_SECRET=
