// Customer-side database. Deliberately a SEPARATE database from the internal app's
// (`cygfinance`): the two apps deploy independently, and a schema push from one must
// never be able to touch the other's tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Models go here. MySQL needs globally unique FK constraint names, so give every
// relation an explicit `map:` (e.g. `fk_<table>_<target>`), as the internal schema does.
